rules_version = '2';

/**
 * Client SDK must not read/write app data.
 * All user, lesson, student, billing, and admin writes go through the
 * Express backend (Firebase Admin SDK bypasses these rules).
 */
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
